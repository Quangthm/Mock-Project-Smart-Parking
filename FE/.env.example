# Frontend environment template - setup.ps1 copies this to FE/.env if missing. Supply your own MapTiler key when needed.
VITE_API_BASE_URL=http://localhost:5035
VITE_PARKING_API_BASE_URL=http://localhost:5045
VITE_RESERVATION_API_BASE_URL=http://localhost:5055
VITE_PAYMENT_API_BASE_URL=http://localhost:5065
VITE_NOTIFICATION_API_BASE_URL=http://localhost:5068
VITE_AI_API_BASE_URL=http://localhost:5001
VITE_AI_LIVE_API_BASE_URL=http://localhost:5002
VITE_MAPTILER_API_KEY=
# Dev-only: serve the operational-layout projection from the local SPARK-228 fixture instead of the parking API.
VITE_OPERATIONAL_LAYOUT_FIXTURE=false
# Cloudflare Turnstile public site key (free tier / test dummy key for local dev)
VITE_TURNSTILE_SITE_KEY=

# Isolated /demo/assistant page: development only, never loads normal account/auth flow.
VITE_ASSISTANT_DEMO_ENABLED=false
# Explicit demo host URL required; no production API fallback.
VITE_ASSISTANT_DEMO_API_BASE_URL=
# Authenticated Admin management API (separate from anonymous demo). Leave empty until available.
VITE_ASSISTANT_API_BASE_URL=
