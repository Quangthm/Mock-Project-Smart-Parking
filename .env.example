# =============================================================================
# SmartPark local environment template.
# Copy this file to .env (setup.ps1 does it automatically) and replace every
# "replace-with-..." placeholder. Never commit the real .env file: it is listed
# in .gitignore and must only be shared through a private team channel.
# =============================================================================

# --- Local database ----------------------------------------------------------
# Password shared by the six local PostgreSQL containers (user / parking /
# reservation / payment / notification / iot).
SMARTPARK_DEV_PASSWORD=replace-with-strong-local-db-password
# Host ports exposed by the local PostgreSQL containers (bound to 127.0.0.1).
SMARTPARK_DB_USER_PORT=5441
SMARTPARK_DB_PARKING_PORT=5442
SMARTPARK_DB_RESERVATION_PORT=5443
# Host ports for the remaining (payment / notification / iot) databases.
SMARTPARK_DB_PAYMENT_PORT=5444
SMARTPARK_DB_NOTIFICATION_PORT=5445
SMARTPARK_DB_IOT_PORT=5446

# --- Service-to-service authentication --------------------------------------
# Shared key used between services; must be at least 32 characters.
# Generated locally by setup.ps1 when missing; existing values are preserved.
SMARTPARK_SERVICE_KEY=replace-with-random-key-at-least-32-characters

# --- Development admin account (UserService) --------------------------------
SMARTPARK_ADMIN_EMAIL=admin@smartpark.local
# Generated locally by setup.ps1 when missing; existing values are preserved.
SMARTPARK_ADMIN_PASSWORD=replace-with-admin-password

# --- OTP email / SMTP (UserService, optional) --------------------------------
# Leave the credential fields empty to disable outbound OTP email locally.
SMARTPARK_SMTP_HOST=smtp.gmail.com
SMARTPARK_SMTP_PORT=587
SMARTPARK_SMTP_USERNAME=
SMARTPARK_SMTP_PASSWORD=
SMARTPARK_SMTP_FROM=

# --- JWT signing (UserService, optional) ------------------------------------
# Leave empty to use an ephemeral Development signing key. Restarting UserService invalidates previously issued JWTs; configure a private PEM for stable local tokens.
SMARTPARK_JWT_PRIVATE_KEY_PEM=

# --- Workflow signing keys (UserService) ------------------------------------
SMARTPARK_WORKFLOW_KEY_DIRECTORY=.cache/workflow-keys

# Operator invitation URL. HTTPS required except explicitly permitted Development loopback.
SMARTPARK_ONBOARDING_PUBLIC_ORIGIN=http://localhost:5173
SMARTPARK_ONBOARDING_ALLOW_HTTP_LOOPBACK=true

# Operator access events / live owner roster. Disabled keeps durable outbox rows pending.
# Enable only after configuring a reachable RabbitMQ broker and dedicated credentials.
SMARTPARK_MESSAGING_ENABLED=false
SMARTPARK_RABBITMQ_HOST=localhost
SMARTPARK_RABBITMQ_PORT=5672
SMARTPARK_RABBITMQ_VIRTUALHOST=/
SMARTPARK_RABBITMQ_USERNAME=
SMARTPARK_RABBITMQ_PASSWORD=

# --- SonarQube (optional; start with setup.ps1 -WithSonarQube) -------------------------------------------
# Web UI at http://localhost:${SONAR_PORT}; first login is admin/admin and the
# password must be changed manually (it cannot be set via environment).
SONAR_PORT=9000
SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
# Optional SonarQube password must be configured manually; setup.ps1 starts SonarQube only with -WithSonarQube.
SONAR_DB_PASSWORD=replace-with-sonar-db-password

# Optional Team import: setup.ps1 -CredentialMode Team -TeamEnvPath <private-file>
# Blank URLs keep localhost defaults. Set reachable host URLs for cross-machine APIs.
SMARTPARK_SERVICE_USER_URL=
SMARTPARK_SERVICE_PARKING_URL=
SMARTPARK_SERVICE_RESERVATION_URL=
# Filled into FE/.env only when its MapTiler key is empty; never overwrite an existing FE key.
VITE_MAPTILER_API_KEY=
# Opt in with setup.ps1 -WithSonarQube; pin an approved image tag for a stable team baseline.
SONAR_IMAGE=sonarqube:community
