    {
      "name": "04 Positive availability only",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{operationBaseUrl}}/api/parking-search?lat={{lat}}&lon={{lon}}&vehicleType=CAR&availableOnly=true",
        "description": "Every returned site has a fresh count above zero."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Safe envelope', () => { pm.expect(body.success).to.eql(true); pm.expect(body.traceId).to.be.a('string'); });",
              "pm.test('Search page contract', () => { pm.expect(body.data.items).to.be.an('array'); pm.expect(body.data).to.have.property('nextCursor'); pm.expect(body.data.asOf).to.be.a('string'); });",
              "pm.test('Positive only', () => body.data.items.forEach(item => { pm.expect(item.availability.availableCount).to.be.above(0); pm.expect(item.fieldStatus.availability.freshness).to.eql('fresh'); }));"
            ]
          }
        }
      ]
    },
