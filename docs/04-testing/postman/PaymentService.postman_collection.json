                  "});",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 422) {",
                  "    pm.test('Returns CORRUPTED_POLICY_SNAPSHOT error code', () => {",
                  "        pm.expect(json.success).to.eql(false);",
                  "        pm.expect(json.errorCode).to.eql('CORRUPTED_POLICY_SNAPSHOT');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantId\": \"11111111-1111-1111-1111-111111111111\",\n  \"siteId\": \"22222222-2222-2222-2222-222222222222\",\n  \"vehicleType\": \"CAR\",\n  \"reservationId\": \"00000000-0000-0000-0000-000000000000\",\n  \"entryTime\": \"2026-10-15T08:00:00+07:00\",\n  \"exitTime\": \"2026-10-15T10:00:00+07:00\"\n}"
            },
            "url": {
