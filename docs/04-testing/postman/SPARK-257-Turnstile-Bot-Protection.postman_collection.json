      ]
    },
    {
      "name": "02 - Bot Verification Rejections (AC2, AC3, AC5)",
      "description": "Kiểm thử các kịch bản token không hợp lệ, thiếu token, token quá dài hoặc không khớp action.",
      "item": [
        {
          "name": "2.1 Reject Missing Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi request không kèm turnstileToken. Mong đợi HTTP 400 và code BOT_VERIFICATION_REQUIRED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error code is BOT_VERIFICATION_REQUIRED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('BOT_VERIFICATION_REQUIRED');",
                  "});",
                  "",
                  "pm.test('Response envelope success is false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
