                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error code is BOT_VERIFICATION_FAILED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('BOT_VERIFICATION_FAILED');",
                  "});",
                  "",
                  "pm.test('Response envelope success is false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.7 Reject Payload Exceeding 64KB (Stage 2 Defense)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{dummyPassToken}}\",\n  \"padding\": \"{{oversizedPadding}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi request body vượt quá giới hạn 64KB (RequestSizeLimit). Mong đợi HTTP 413 PAYLOAD_TOO_LARGE."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const padding = 'a'.repeat(66000);",
                  "pm.variables.set('oversizedPadding', padding);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 413 Payload Too Large', function () {",
                  "    pm.response.to.have.status(413);",
                  "});",
                  "",
                  "pm.test('Error code is PAYLOAD_TOO_LARGE', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('PAYLOAD_TOO_LARGE');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Rate Limiting Protection (Layered Defense)",
      "description": "Kiểm thử cơ chế Rate Limiting (10 req/phút/IP) hoạt động trước khi bot verification được gọi.",
      "item": [
        {
          "name": "3.1 Burst Consumption of Rate Limit Quota",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{dummyPassToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Thực hiện burst gửi liên tiếp các request để tiêu thụ quota 10 request/phút của LoginRateLimit."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const targetUrl = pm.environment.get('userServiceUrl') + '/api/auth/login';",
                  "const payload = JSON.stringify({",
                  "    email: pm.environment.get('driverEmail'),",
                  "    password: pm.environment.get('driverPassword'),",
                  "    turnstileToken: pm.environment.get('dummyPassToken')",
                  "});",
                  "// Burst 10 requests rapidly to consume the window quota",
                  "for (let i = 0; i < 10; i++) {",
                  "    pm.sendRequest({",
                  "        url: targetUrl,",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: payload }",
                  "    }, function (err, res) {});",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Burst request completes', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 429]);",
                  "});",
                  "",
                  "pm.test('Rate limiting quota burst executed', function () {",
                  "    pm.expect(true).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Rate Limit Exceeded (Assert HTTP 429)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{dummyPassToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi request vượt quá giới hạn hạn mức 10 req/phút. Mong đợi HTTP 429 Too Many Requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 429 Too Many Requests', function () {",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "",
                  "pm.test('Rate limit header or response is enforced', function () {",
                  "    pm.expect(pm.response.code).to.eql(429);",
                  "});",
                  "",
                  "pm.test('Layered defense blocks before downstream service', function () {",
                  "    pm.expect(pm.response.status).to.match(/Too Many Requests/i);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
