              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{dummyFailToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi turnstileToken không hợp lệ (Cloudflare trả invalid-input-response). Mong đợi HTTP 400 BOT_VERIFICATION_FAILED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error code is BOT_VERIFICATION_FAILED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('BOT_VERIFICATION_FAILED');",
                  "});",
                  "",
                  "pm.test('Response envelope success is false', function () {",
