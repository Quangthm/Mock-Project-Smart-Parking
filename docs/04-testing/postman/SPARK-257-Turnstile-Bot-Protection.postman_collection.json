              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Action Mismatch Tester\",\n  \"email\": \"{{tempMismatchEmail}}\",\n  \"phone\": \"0912345678\",\n  \"password\": \"Password@123\",\n  \"turnstileToken\": \"{{dummyFailToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/register/driver",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "register", "driver"]
            },
            "description": "Gửi token không khớp action (hoặc provider verification fail). Mong đợi HTTP 400 BOT_VERIFICATION_FAILED."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = 'mismatch_' + Date.now() + '@test.local';",
                  "pm.variables.set('tempMismatchEmail', uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
