                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Reject Expired or Duplicate Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{dummyExpiredToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi turnstileToken đã hết hạn hoặc đã sử dụng (Cloudflare trả timeout-or-duplicate). Mong đợi HTTP 400 BOT_VERIFICATION_EXPIRED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error code is BOT_VERIFICATION_EXPIRED or BOT_VERIFICATION_FAILED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.be.oneOf(['BOT_VERIFICATION_EXPIRED', 'BOT_VERIFICATION_FAILED']);",
                  "});",
                  "",
                  "pm.test('Response envelope success is false', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Reject Token Exceeding 2048 Chars",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{driverEmail}}\",\n  \"password\": \"{{driverPassword}}\",\n  \"turnstileToken\": \"{{oversizedToken}}\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/login",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Gửi token dài hơn 2048 ký tự. Mong đợi HTTP 400 BOT_VERIFICATION_FAILED (không ném VALIDATION_FAILED)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const oversized = 'x'.repeat(2049);",
                  "pm.variables.set('oversizedToken', oversized);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error code is BOT_VERIFICATION_FAILED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.eql('BOT_VERIFICATION_FAILED');",
                  "});",
                  "",
                  "pm.test('Does not throw generic VALIDATION_FAILED', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.code).to.not.eql('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
