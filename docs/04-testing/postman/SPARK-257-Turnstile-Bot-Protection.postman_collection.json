            },
            "url": {
              "raw": "{{userServiceUrl}}/api/auth/register/driver",
              "host": ["{{userServiceUrl}}"],
              "path": ["api", "auth", "register", "driver"]
            },
            "description": "Đăng ký tài xế thành công với turnstileToken hợp lệ. Mong đợi HTTP 201 Created."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueEmail = 'driver_qa_' + Date.now() + '@test.local';",
                  "pm.variables.set('tempDriverEmail', uniqueEmail);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response envelope success is true', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
