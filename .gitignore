# 1. SECURITY & ENVIRONMENT SECRETS
.env
.env.production
.env.local
*.env.local

# Ignore local setup script to prevent pushing machine-specific configs & secrets
setup.ps1
*.ps1

# Ignore dotnet user-secrets local storage folder
secrets.json

