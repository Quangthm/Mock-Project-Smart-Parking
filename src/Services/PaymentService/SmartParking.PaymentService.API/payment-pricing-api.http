@baseUrl = http://localhost:5065

### 1. Happy Path - Tính giá đỗ xe dưới ngưỡng miễn phí (<= 15 phút)
# Kỳ vọng: HTTP 200 OK, isFreeStay = true, finalAmountVnd = 0
POST {{baseUrl}}/api/v1/pricing/calculate
Content-Type: application/json

{
  "tenantId": "11111111-1111-1111-1111-111111111111",
  "siteId": "22222222-2222-2222-2222-222222222222",
  "vehicleType": "CAR",
  "entryTime": "2026-10-23T08:00:00+07:00",
  "exitTime": "2026-10-23T08:12:00+07:00",
  "policyOverride": {
    "tariffId": "33333333-3333-3333-3333-333333333333",
    "tariffName": "Biểu phí v1.0",
    "policyVersion": 1,
    "vehicleType": "CAR",
    "freeParkingGraceMinutes": 15,
    "timeBlocks": [
      {
        "blockCode": "DAY_TIME",
        "startTime": "06:00:00",
        "endTime": "18:00:00",
        "ratePerHourVnd": 20000
      },
      {
        "blockCode": "NIGHT_TIME",
        "startTime": "18:00:00",
        "endTime": "06:00:00",
        "ratePerHourVnd": 30000
      }
    ],
    "timeZoneId": "Asia/Ho_Chi_Minh",
    "roundingMode": "HALF_UP_THOUSAND"
  }
}

### 2. Happy Path - Tính giá đỗ xe vượt 15 phút (Tính trọn vẹn thời gian, làm tròn half-up 1.000 VNĐ)
# Kỳ vọng: HTTP 200 OK, isFreeStay = false, tính đầy đủ số phút theo đơn giá block
POST {{baseUrl}}/api/v1/pricing/calculate
Content-Type: application/json

{
  "tenantId": "11111111-1111-1111-1111-111111111111",
  "siteId": "22222222-2222-2222-2222-222222222222",
  "vehicleType": "CAR",
  "entryTime": "2026-10-23T08:00:00+07:00",
  "exitTime": "2026-10-23T10:30:00+07:00",
  "policyOverride": {
    "tariffId": "33333333-3333-3333-3333-333333333333",
    "tariffName": "Biểu phí v1.0",
    "policyVersion": 1,
    "vehicleType": "CAR",
    "freeParkingGraceMinutes": 15,
    "timeBlocks": [
      {
        "blockCode": "ALL_DAY",
        "startTime": "00:00:00",
        "endTime": "00:00:00",
        "ratePerHourVnd": 20000
      }
    ],
    "timeZoneId": "Asia/Ho_Chi_Minh",
    "roundingMode": "HALF_UP_THOUSAND"
  }
}

### 3. Validation Error - Giờ ra sớm hơn giờ vào (ExitTime < EntryTime)
# Kỳ vọng: HTTP 400 Bad Request
POST {{baseUrl}}/api/v1/pricing/calculate
Content-Type: application/json

{
  "tenantId": "11111111-1111-1111-1111-111111111111",
  "siteId": "22222222-2222-2222-2222-222222222222",
  "vehicleType": "CAR",
  "entryTime": "2026-10-23T10:00:00+07:00",
  "exitTime": "2026-10-23T08:00:00+07:00"
}
