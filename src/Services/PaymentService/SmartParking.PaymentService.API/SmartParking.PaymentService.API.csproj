<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>SmartParking.PaymentService.API.LocalDevelopment</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartParking.PaymentService.Application\SmartParking.PaymentService.Application.csproj" />
    <ProjectReference Include="..\SmartParking.PaymentService.Infrastructure\SmartParking.PaymentService.Infrastructure.csproj" />
    <ProjectReference Include="..\SmartParking.PaymentService.Persistence\SmartParking.PaymentService.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="CopyLocalDevSettings" AfterTargets="Build" Condition="Exists('appsettings.Development.json')">
    <Copy SourceFiles="appsettings.Development.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
