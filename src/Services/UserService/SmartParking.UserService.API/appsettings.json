{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=smartpark_db;Username=smartpark_user;Password=smartpark_password"
  },
  "Jwt": {
    "Issuer": "SmartParking.UserService",
    "Audience": "SmartParking"
  },
  "AuthenticationPolicy": {
    "MaxFailedLoginAttempts": 3,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
