{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "SmartParking.UserService",
    "Audience": "SmartParking"
  },
  "AuthenticationPolicy": {
    "MaxFailedLoginAttempts": 3,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*",
  "Turnstile": {
    "Enabled": true,
    "ExpectedHostnames": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  }
}
